{
  "name": "witcher3-build-planner",
  "private": true,
  "version": "2.12.0",
  "description": "Skill planner for The Witcher 3: Wild Hunt Remastered",
  "author": "Attila Nyiri",
  "license": "MIT",
  "homepage": "https://nyiriattila88.github.io/witcher3-build-planner/",
  "repository": {
    "type": "git",
    "url": "https://github.com/nyiriattila88/witcher3-build-planner.git"
  },
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && knip"
  },
  "dependencies": {
    "@fontsource/barlow-semi-condensed": "5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "knip": "^6.39.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
